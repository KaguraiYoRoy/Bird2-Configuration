auto dn42
iface dn42 inet static
    pre-up ip link add $IFACE type dummy || true
    # --- 注册路由表 ---
    pre-up grep -q "1042 dn42" /etc/iproute2/rt_tables || echo "1042 dn42" >> /etc/iproute2/rt_tables
    pre-up grep -q "1142 dn42-wg" /etc/iproute2/rt_tables || echo "1142 dn42-wg" >> /etc/iproute2/rt_tables

    address 172.20.234.225/32
    address fd18:3e15:61d0::1/128

    # --- 1142 表默认路由 ---
    post-up /bin/sh -c 'ip route show default table main | head -n1 | sed "s/$/ onlink/" | while read -r route; do ip route add $route table 1142; done'
    post-up /bin/sh -c 'ip -6 route show default table main | head -n1 | sed "s/$/ src 2401:5a0:1000:3b::a/" | while read -r route; do ip -6 route add $route table 1142; done'

    # --- WireGuard Fwmark 策略 ---
    post-up ip rule add fwmark 4242 lookup 1142 pref 90
    post-up ip -6 rule add fwmark 4242 lookup 1142 pref 90

    # --- DN42 网段策略 ---
    post-up ip rule add to 10.0.0.0/8 lookup 1042 pref 100
    post-up ip rule add to 172.20.0.0/14 lookup 1042 pref 100
    post-up ip rule add to 172.31.0.0/16 lookup 1042 pref 100
    post-up ip rule add to 10.127.0.0/16 lookup 1042 pref 100
    post-up ip -6 rule add to fd00::/8 lookup 1042 pref 100

    # --- 清理逻辑 ---
    pre-down ip rule del fwmark 4242 lookup 1142 pref 90 || true
    pre-down ip -6 rule del fwmark 4242 lookup 1142 pref 90 || true
    # 彻底清空 1142 表
    pre-down ip route flush table 1142 || true
    pre-down ip -6 route flush table 1142 || true
    
    pre-down ip rule del to 10.0.0.0/8 lookup 1042 pref 100 || true
    pre-down ip rule del to 172.20.0.0/14 lookup 1042 pref 100 || true
    pre-down ip rule del to 172.31.0.0/16 lookup 1042 pref 100 || true
    pre-down ip rule del to 10.127.0.0/16 lookup 1042 pref 100 || true
    pre-down ip -6 rule del to fd00::/8 lookup 1042 pref 100 || true
    post-down ip link del $IFACE
