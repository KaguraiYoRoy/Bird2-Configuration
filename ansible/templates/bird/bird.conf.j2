{% if bird.log_syslog_all | default(false) %}
log syslog all;

{% endif %}
{% set derived_public_region_nibble = node.region * 2 %}
{% set derived_public_ipv6 = '2a14:7583:f2%01x4::%s' | format(derived_public_region_nibble, node.node_token) %}
{% set derived_public_net_v6 = '2a14:7583:f2%01x0::/43' | format(derived_public_region_nibble) %}
{% set derived_intra_as = intra_global.confederation_as_format | format(node.tier, node.region, node.node_id) %}
{% set derived_intra_loopback_v4 = '100.64.%d.%d' | format(node.tier * 10 + node.region, node.node_id) %}
{% set derived_intra_loopback_v6 = '%s:%d:%d::%s' | format(intra_global.loopback_v6_prefix, node.tier, node.region, node.node_token) %}
{% set derived_intra_lla = '%s:%d:%d:%s' | format(intra_global.link_local_prefix, node.tier, node.region, node.node_token) %}
{% if iana is defined and iana.enabled | default(false) %}
define IANA_OWNAS                = {{ iana_global.own_as }};
define IANA_OWNIPv6              = {{ iana.own_ipv6 | default(derived_public_ipv6) }};
define IANA_AnycastNETv6         = {{ iana_global.anycast_net_v6 }};
define IANA_OWNNETv6             = {{ iana.own_net_v6 | default(derived_public_net_v6) }};
define IANA_OWNNETSETv6          = {{ iana.own_netset_v6 | default(iana_global.own_netset_v6) }};
define IANA_ROUTER_ID            = {{ iana.router_id }};
define IANA_ALLOW_NETSETv6       = {{ iana.allow_netset_v6 | default(iana_global.allow_netset_v6) }};

{% endif %}{% if dn42 is defined %}
define DN42_OWNAS                = {{ dn42_global.own_as }};
define DN42_OWNIP                = {{ dn42.own_ip }};
define DN42_OWNIPv6              = {{ dn42.own_ipv6 }};
define DN42_OWNNET               = {{ dn42_global.own_net }};
define DN42_OWNNETv6             = {{ dn42_global.own_net_v6 }};
define DN42_OWNNETSET            = {{ dn42_global.own_netset }};
define DN42_OWNNETSETv6          = {{ dn42_global.own_netset_v6 }};
define DN42_REGION               = {{ dn42.region }};
define DN42_COUNTRY              = {{ dn42.country }};

{% endif %}{% if intra is defined %}
define INTRA_CONFEDERATION_START = {{ intra_global.confederation_start }};
define INTRA_CONFEDERATION_END   = {{ intra_global.confederation_end }};
define INTRA_OWNAS               = {{ intra.own_as | default(derived_intra_as) }};
define INTRA_ROUTERID            = {{ intra.router_id | default(derived_intra_loopback_v4) }};
define INTRA_PREFIX_V4           = {{ intra_global.prefix_v4 }};
define INTRA_PREFIX_V6           = {{ intra_global.prefix_v6 }};
define INTRA_LOOPBACKv4          = {{ intra.loopback_v4 | default(derived_intra_loopback_v4) }};
define INTRA_LOOPBACKv4NET       = {{ intra.loopback_v4_net | default((intra.loopback_v4 | default(derived_intra_loopback_v4)) ~ '/32') }};
define INTRA_LOOPBACKv6          = {{ intra.loopback_v6 | default(derived_intra_loopback_v6) }};
define INTRA_LOOPBACKv6NET       = {{ intra.loopback_v6_net | default((intra.loopback_v6 | default(derived_intra_loopback_v6)) ~ '/128') }};
define INTRA_LLA                 = {{ intra.link_local_v6 | default(derived_intra_lla) }};
{% endif %}
define BLACKHOLE              = (65535, 666);
define NO_EXPORT              = (65535, 65281);
define NO_ADVERTISE           = (65535, 65282);

protocol device {
    scan time {{ bird.device_scan_time | default(10) }};
}{% if bird.device_semicolon | default(false) %};{% endif %}

{% set iana_enabled = iana is defined and iana.enabled | default(false) %}
{% set dn42_enabled = dn42 is defined %}
{% set intra_enabled = intra is defined %}

{# ── IANA includes (auto-derived, modules.iana.includes overrides) ── #}
{% set _iana_upstream_count = (iana.upstreams4 | default([]) | length) + (iana.upstreams6 | default([]) | length) %}
{% set _iana_has_peers = (iana.peers | default([]) | length) > 0 %}
{% set _iana_has_downstreams = (iana.downstreams | default([]) | length) > 0 %}
{% set _iana_has_ibgp = (iana.ibgp | default({})).enabled | default(false) %}
{% set iana_default_includes = ['rpki.conf', 'filter.conf', 'static.conf'] %}
{% if _iana_upstream_count > 0 %}{% set iana_default_includes = iana_default_includes + ['upstream.conf'] %}{% endif %}
{% if _iana_has_peers %}{% set iana_default_includes = iana_default_includes + ['peer.conf'] %}{% endif %}
{% if _iana_has_downstreams %}{% set iana_default_includes = iana_default_includes + ['downstream.conf'] %}{% endif %}
{% if _iana_has_ibgp %}{% set iana_default_includes = iana_default_includes + ['ibgp.conf'] %}{% endif %}

{# ── DN42 includes (auto-derived, modules.dn42.includes overrides) ── #}
{% set _dn42_has_peers = (dn42.peers | default([]) | length) > 0 %}
{% set _dn42_has_ix = (dn42.ix | default({})).sessions | default([]) | length > 0 %}
{% set _dn42_inactive = modules.dn42.inactive_files | default([]) %}
{% if 'rpki.conf' in _dn42_inactive %}
{% set dn42_default_includes = ['filter.conf', 'flapalerted.conf', 'static.conf'] %}
{% else %}
{% set dn42_default_includes = ['rpki.conf', 'filter.conf', 'flapalerted.conf', 'static.conf'] %}
{% endif %}
{% if _dn42_has_peers %}{% set dn42_default_includes = dn42_default_includes + ['ebgp.conf'] %}{% endif %}
{% if _dn42_has_ix %}{% set dn42_default_includes = dn42_default_includes + ['ix.conf'] %}{% endif %}

{# ── Intra includes (auto-derived, modules.intra.includes overrides) ── #}
{% set intra_default_includes = ['filter.conf', 'ibgp.conf', 'static.conf'] %}

{# ── Render includes ── #}
{% set root_includes = ['filter.conf'] %}
{% if iana_enabled and (_iana_has_peers or _iana_has_downstreams) %}
{% set root_includes = root_includes + ['iana_downstream_whitelist.conf'] %}
{% endif %}
{% set root_includes = root_includes + (bird.extra_root_includes | default([])) %}
{% for include in root_includes | unique %}
include "{{ include }}";
{% endfor %}

{% if iana_enabled %}
{% for include in modules.iana.includes | default(iana_default_includes) %}
include "iana/{{ include }}";
{% endfor %}
{% endif %}

{% if dn42_enabled %}
{% for include in modules.dn42.includes | default(dn42_default_includes) %}
include "dn42/{{ include }}";
{% endfor %}
{% endif %}

{% if intra_enabled %}
{% for include in modules.intra.includes | default(intra_default_includes) %}
include "intra/{{ include }}";
{% endfor %}
{% endif %}

include "kernel.conf";