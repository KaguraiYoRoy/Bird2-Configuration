protocol kernel kernel_v4{  
    ipv4 {
        table master4;
        import none;
        export filter {
            if source = RTS_STATIC then reject;
            if bgp_large_community ~ [(4242422024,*,*)] then krt_prefsrc = DN42_OWNIP;
            accept;
        };
    };
}

protocol kernel kernel_v6 {
    ipv6 {
        table master6;
        import none;
        export filter {
            if source = RTS_STATIC then reject;
            if bgp_large_community ~ [(4242422024,*,*)] then krt_prefsrc = DN42_OWNIPv6;
{% if iana.enabled | default(false) %}            else krt_prefsrc = IANA_OWNIPv6;
{% endif %}            accept;
        };
    };
}
