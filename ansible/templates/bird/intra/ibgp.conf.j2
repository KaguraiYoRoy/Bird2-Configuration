function intra_ibgp_check_community(){
    if !(bgp_large_community ~ [(IANA_OWNAS,1,1)] || bgp_large_community ~ [(DN42_OWNAS,1,1)]) then return false;
    if bgp_large_community ~ [(IANA_OWNAS,65535,65282)] || bgp_large_community ~ [(DN42_OWNAS,65535,65282)] then return false;

    if bgp_large_community ~ [(IANA_OWNAS,2,*)] then return false;

    return true;
}

template bgp intra_ibgpeers {
    router   id INTRA_ROUTERID;
    local    as INTRA_OWNAS;
    neighbor external;

    ipv4 {
        table master4;
        import filter{
            if !intra_ibgp_check_community() then reject;
            accept;
        };
        export filter {
            if !intra_ibgp_check_community() then reject;
            accept;
        };
        extended next hop;
    };
    ipv6 {
        table master6;
        import filter{
            if !intra_ibgp_check_community() then reject;
            accept;
        };
        export filter {
            if !intra_ibgp_check_community() then reject;
            accept;
        };
    };
};

include "ibgp/*";
