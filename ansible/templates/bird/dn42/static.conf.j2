protocol static dn42_static_v4{
    route DN42_OWNNET reject;

    ipv4 {
        import filter{
            bgp_large_community.add((DN42_OWNAS,1,1));
            bgp_large_community.add((DN42_OWNAS,2,100));
            accept;
        };
        export none;
    };
}

protocol static dn42_static_v6{
    route DN42_OWNNETv6 reject;

    ipv6 {
        import filter{
            bgp_large_community.add((DN42_OWNAS,1,1));
            bgp_large_community.add((DN42_OWNAS,2,100));
            accept;
        };
        export none;
    };
}
