{% set peer_interface = peer.neighbor.interface | default('dn42_' ~ peer.asn) %}
protocol bgp 'dn42_peer_{{ peer.asn }}' from dnpeers {
{% if peer.description is defined and peer.description is not none %}    description "{{ peer.description | replace('\\', '\\\\') | replace('\"', '\\"') }}";
{% endif %}    neighbor {{ peer.neighbor.address }}{% if peer_interface %} % '{{ peer_interface }}'{% endif %} as {{ peer.asn }}{% if peer.neighbor.port is defined %} port {{ peer.neighbor.port }}{% endif %};
{% if peer.ipv4.extended_next_hop | default(false) %}    ipv4{
        extended next hop;
    };
{% endif %}};
