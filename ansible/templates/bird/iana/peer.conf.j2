function iana_peer_add_community(){
    bgp_large_community.add((205369,1,1));
    bgp_large_community.add((205369,2,101));
}

function iana_peer_check_community(){
    if !(bgp_large_community ~ [(205369,1,1)]) then return false;
    if bgp_large_community ~ [(205369,65535,65282)] then return false;
    if bgp_large_community ~ [(205369,65535,65281)] then return false;

    if bgp_large_community ~ [(205369,2,0)] then return false;
    if bgp_large_community ~ [(205369,2,101)] then return false;
    if bgp_large_community ~ [(205369,2,102)] then return false;

    return true;
}

template bgp iana_peer{
    router id IANA_ROUTER_ID;
    local as IANA_OWNAS;
    ipv6 {
        import filter {
            if !iana_filter_default_check() then reject;
            remove_confederation_as();
            remove_private_community();
            iana_peer_add_community();
            accept;
        };
        export filter {
            if !iana_filter_default_check() then reject;
            if !iana_peer_check_community() then reject;
            remove_confederation_as();
            remove_private_community();
            accept;
        };
    };
    graceful restart;
}
{% for peer in iana.peers | default([]) %}
protocol bgp '{{ peer.protocol }}' from iana_peer{
{% if peer.description is defined and peer.description is not none %}    description "{{ peer.description | replace('\\', '\\\\') | replace('\"', '\\"') }}";
{% endif %}    local {{ peer.local }};
    neighbor {{ peer.neighbor.address }} as {{ peer.neighbor.asn }};
}
{% endfor %}
