function iana_upstream_add_community(){
    bgp_large_community.add((IANA_OWNAS,1,1));
    bgp_large_community.add((IANA_OWNAS,2,102));
}

function iana_upstream_check_community(){
    if !(bgp_large_community ~ [(IANA_OWNAS,1,1)]) then return false;
    if bgp_large_community ~ [(IANA_OWNAS,65535,65282)] then return false;
    if bgp_large_community ~ [(IANA_OWNAS,65535,65281)] then return false;

    if bgp_large_community ~ [(IANA_OWNAS,2,0)] then return false;
    if bgp_large_community ~ [(IANA_OWNAS,2,101)] then return false;
    if bgp_large_community ~ [(IANA_OWNAS,2,102)] then return false;

    return true;
}

template bgp iana_upstream {
    local as IANA_OWNAS;
    path metric 1;
    router id IANA_ROUTER_ID;

    ipv6 {
        import filter {
            if !iana_filter_default_check() then reject;
            remove_confederation_as();
            remove_private_community();
            iana_upstream_add_community();
            accept;
        };
        export filter {
            if !iana_filter_default_check() then reject;
            if !iana_upstream_check_community() then reject;
            remove_confederation_as();
            remove_private_community();
            accept;
        };
        export limit 10;
    };

    graceful restart; 
}
{% for upstream in iana.upstreams | default([]) %}
protocol bgp '{{ upstream.protocol }}' from iana_upstream{
{% if upstream.description is defined and upstream.description is not none %}    description "{{ upstream.description | replace('\\', '\\\\') | replace('\"', '\\"') }}";
{% endif %}    neighbor {{ upstream.neighbor.address }} as {{ upstream.neighbor.asn }};
{% if upstream.multihop is defined %}    multihop {{ upstream.multihop }};
{% endif %}{% if upstream.password_ref is defined %}    password "{{ bird_secrets.bgp_passwords[upstream.password_ref] | replace('\\', '\\\\') | replace('\"', '\\"') }}";
{% endif %}}
{% endfor %}
