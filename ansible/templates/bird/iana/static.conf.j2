protocol static iana_static_advertise{
{% for route in iana.static.advertise_routes %}    route {{ route }} reject;
{% endfor %}
    ipv6 {
        import filter{
            bgp_large_community.add((205369,1,1));
            bgp_large_community.add((205369,2,100));
            accept;
        };
        export none;
    };
}
{% for route in iana.static.extra_routes | default([]) %}
protocol static {{ route.protocol }}{
{% if route.via is defined %}
    {% if route.via.address is defined %}    
        route {{ route.prefix }} via {{ route.via.address }}{% if route.via.interface is defined and route.via.interface %} % '{{ route.via.interface }}'{% endif %};
    {% else %}    
        route {{ route.prefix }} via "{{ route.via.interface }}";
    {% endif%}
{% else %}
    route {{ route.prefix }} reject;
{% endif %}
    ipv6 {
        import filter{
{% for community in route.communities %}            
            bgp_community.add({{ community }});
{% endfor %}
{% for community in route.large_communities %}            
            bgp_large_community.add({{ community }});
{% endfor %}                        
            accept;
        };
        export none;
    };
}
{% endfor %}
