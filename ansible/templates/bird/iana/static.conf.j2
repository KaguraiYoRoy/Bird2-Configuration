{% macro render_communities(community_list, community_aliases, indent='        ') -%}
{% for community in community_list | default([]) -%}
{% set resolved_community = (community_aliases[community] | mandatory) if community is string else community -%}
{% if resolved_community | length == 2 -%}
{{ indent }}bgp_community.add(({{ resolved_community | join(',') }}));
{% else -%}
{{ indent }}bgp_large_community.add(({{ resolved_community | join(',') }}));
{% endif -%}
{% endfor -%}
{% endmacro %}
protocol static iana_static_advertise{
{% for route in iana.static.advertise_routes %}{% if route is mapping %}
{% set communities = route.communities | default([]) %}    route {{ route.prefix | mandatory }} reject{% if communities %} {
{{ render_communities(communities, bgp_community_aliases) }}    }{% endif %};
{% else %}    route {{ route }} reject;
{% endif %}{% endfor %}
    ipv6 {
        import filter{
            bgp_large_community.add((205369,1,1));
            bgp_large_community.add((205369,2,100));
            accept;
        };
        export none;
    };
}
{% for route_group in iana.static.extra_routes | default([]) %}
{% if route_group.prefixes is defined %}
protocol static {{ route_group.name | default(route_group.protocol) }}{
{% for route in route_group.prefixes %}
{% set communities = route.communities | default([]) %}
{% if route.via is defined %}
{% if route.via.recursive is defined %}    route {{ route.prefix }} recursive {{ route.via.recursive }}{% if communities %} {
{{ render_communities(communities, bgp_community_aliases) }}    }{% endif %};
{% elif route.via.address is defined %}    route {{ route.prefix }} via {{ route.via.address }}{% if route.via.interface is defined and route.via.interface %} % '{{ route.via.interface }}'{% endif %}{% if communities %} {
{{ render_communities(communities, bgp_community_aliases) }}    }{% endif %};
{% else %}    route {{ route.prefix }} via "{{ route.via.interface }}"{% if communities %} {
{{ render_communities(communities, bgp_community_aliases) }}    }{% endif %};
{% endif %}
{% else %}    route {{ route.prefix }} reject{% if communities %} {
{{ render_communities(communities, bgp_community_aliases) }}    }{% endif %};
{% endif %}
{% endfor %}
    ipv6 {
        import all;
        export none;
    };
}
{% else %}
{% set communities = route_group.communities | default([]) %}
protocol static {{ route_group.protocol }}{
{% if route_group.via is defined %}
    {% if route_group.via.address is defined %}
        route {{ route_group.prefix }} via {{ route_group.via.address }}{% if route_group.via.interface is defined and route_group.via.interface %} % '{{ route_group.via.interface }}'{% endif %};
    {% else %}
        route {{ route_group.prefix }} via "{{ route_group.via.interface }}";
    {% endif%}
{% else %}
    route {{ route_group.prefix }} reject;
{% endif %}
    ipv6 {
        import filter{
{{ render_communities(communities, bgp_community_aliases, '            ') }}            accept;
        };
        export none;
    };
}
{% endif %}
{% endfor %}
