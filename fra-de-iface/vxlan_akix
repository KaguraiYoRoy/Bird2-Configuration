auto vxlan_akix
iface vxlan_akix inet6 static
    address 2a14:67c1:a080::3224/64
    pre-up ip link add vxlan_akix type vxlan \
        id 1000 \
        dev eth0 \
        dstport 4789 \
        remote 136.244.83.121 \
        learning
    up ip link set vxlan_akix up
    down ip link set vxlan_akix down
    post-down ip link del vxlan_akix
